# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/

# build.py writes the platform trees, release zips, and checksums here.
# The published packages are GitHub Release assets, not git files.
dist/

# Stray copies of the release packages, if they land in the repo root.
/AgentParcel-*.zip
/SHA256SUMS.txt

# Generated from the repo-root CHANGELOG.md by build.py. Edit that file only.
/src/release/CHANGELOG.md
